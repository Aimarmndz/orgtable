# orgtable environment variable template.
# In a real installation, install.sh generates a .env with random secrets.
# For local development, copy this file to .env and adjust the values.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=orgtable
POSTGRES_PASSWORD=changeme
POSTGRES_DB=orgtable

# Connection URL used by the app. In docker-compose the host is "postgres" (the service
# name). In local development it is usually localhost with the mapped port.
DATABASE_URL=postgresql://orgtable:changeme@postgres:5432/orgtable

# --- Application -------------------------------------------------------------
# Secret used to sign the JWT sessions. REQUIRED, at least 16 characters: without it (or
# with a shorter one) the app starts, but it cannot create sessions and both login and
# the setup wizard fail. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Port exposed on the host. Also accepts "127.0.0.1:3000" to publish the app on
# localhost only, behind a reverse proxy (see docs/self-hosting.md).
APP_PORT=3000

# Time zone (IANA) for dates formatted by the server. Defaults to Atlantic/Canary.
# ORGTABLE_TIMEZONE=Atlantic/Canary

# Number of trusted proxies in front of the app (integer >= 0). With 0 (the default)
# X-Forwarded-For is ignored and the login attempt limit is per email only. With N > 0
# the N-th IP of X-Forwarded-For counting from the right is used (1 = a single reverse
# proxy, e.g. Caddy or nginx). See docs/self-hosting.md.
# TRUSTED_PROXY_HOPS=0

# Directory where card attachments are stored. In docker-compose it is a persistent
# volume mounted at /data/uploads (the default). In local development, if unset,
# ./uploads is used. See docs/attachments.md.
# ORGTABLE_UPLOAD_DIR=/data/uploads

# --- Real time (optional) ----------------------------------------------------
# Live sync between users. By default it works in-process (a single app container),
# with no configuration. If you deploy SEVERAL app replicas behind a load balancer, set
# this to 1 to propagate events between instances via PostgreSQL LISTEN/NOTIFY (no
# Redis needed). See docs/realtime.md.
# ORGTABLE_REALTIME_PG_NOTIFY=0

# --- Due-date reminders (optional) -------------------------------------------
# Setting a secret enables the POST /api/cron/reminders endpoint, which creates
# notifications for cards that are due soon or overdue. It must be triggered by an
# EXTERNAL scheduler (system cron, etc.) sending the secret as a Bearer token:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/reminders
# install.sh generates it for you; by hand: openssl rand -hex 32. See docs/reminders.md.
# CRON_SECRET=

# --- Privacy and open source (optional) --------------------------------------
# Days the audit log is kept (it includes IPs if TRUSTED_PROXY_HOPS > 0). It is purged
# by POST /api/cron/maintenance, with the same CRON_SECRET; schedule it once a day.
# Integer >= 1. See docs/privacy.md.
# ORGTABLE_AUDIT_RETENTION_DAYS=90

# "Source code" link shown by the app. The AGPL (section 13) requires offering the source
# to whoever uses the app over a network: if you deploy a MODIFIED version, point this
# at your fork. Empty = the original repository.
# ORGTABLE_SOURCE_URL=https://github.com/Aimarmndz/orgtable
