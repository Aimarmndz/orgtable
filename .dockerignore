# Keep out of the build context anything that is regenerated or not needed in the image.
node_modules
.next
.git
.gitignore

# Secrets: must NEVER end up in the image (they are injected via the environment at runtime).
.env
.env.*
!.env.example

# Documentation and development tooling.
docs
*.md
.claude
.agents
skills-lock.json

# Local data: backups (dumps with personal data), development attachments and keys.
# `COPY . .` would put them in the builder and its cache. `**/` also covers
# subdirectories.
backups
**/*.sql.gz
**/*.tar.gz
uploads
data
**/*.pem

# Things the image does not use: tests, coverage and scripts that run on the host.
coverage
test
scripts
install.sh

# Logs and temporary files
npm-debug.log*
*.tsbuildinfo
