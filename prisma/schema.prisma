// orgtable — database schema (Prisma + PostgreSQL)
// Documented in docs/database.md. Decisions: docs/decisions/0001-prisma.md,
// 0002-fractional-indexing.md.

generator client {
  provider = "prisma-client-js"
}

// In Prisma 7 the `url` NO longer goes here: it is defined in prisma.config.ts (for the
// Migrate CLI) and at runtime PrismaClient connects through the @prisma/adapter-pg
// driver adapter (see app/lib/prisma.ts). The query engine is WASM, not a binary, so
// there is no need for `binaryTargets` or copying engines into the Docker image.
datasource db {
  provider = "postgresql"
}

// Instance-wide settings. A single row (fixed id "singleton").
// A non-null `setupCompletedAt` is the source of truth for "the instance is already
// set up"; while it is null, the setup wizard (/setup) is active.
model InstanceConfig {
  id                  String    @id @default("singleton")
  instanceName        String
  setupCompletedAt    DateTime?
  createdAt           DateTime  @default(now())
  // Open sign-up: anyone can create an account at /register. Closed by default (private
  // instance, the admin creates accounts). It can only be opened once the controller and
  // the privacy contact are set, because the privacy policy needs them.
  registrationOpen    Boolean   @default(false)
  // Legal details of WHOEVER OPERATES this instance (not the software's author). Shown
  // on /legal/*. All optional: without them the legal pages say so instead of making
  // anything up. See docs/privacy.md.
  operatorName        String?
  operatorEmail       String?
  operatorLegalId     String?
  operatorAddress     String?
  hostingDescription  String?
  backupRetentionDays Int?
  // Date the legal details were last edited: it is the "last updated" date shown on the
  // legal pages.
  legalUpdatedAt      DateTime?
}

enum Role {
  ADMIN
  MEMBER
}

enum BoardRole {
  OWNER
  EDITOR
  VIEWER
}

// A workspace is the first segment of every board URL (/<workspace>/<board>). PERSONAL:
// one per user, its slug is the user's handle. ORGANIZATION: a company or team that
// anyone can register for free; its admins create the employees' accounts. See
// docs/workspaces.md.
enum WorkspaceKind {
  PERSONAL
  ORGANIZATION
}

// Role inside a workspace. OWNER > ADMIN > MEMBER: see app/lib/roles.ts for what each
// one can do and docs/authorization.md for the rules against privilege escalation.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// Who sees a board of an organization besides its explicit members: every member of the
// workspace (WORKSPACE) or only its members plus the workspace's owners and admins
// (PRIVATE).
enum BoardVisibility {
  WORKSPACE
  PRIVATE
}

model Workspace {
  id              String            @id @default(cuid())
  // URL segment, unique across users and organizations (one namespace, like GitHub).
  // Lowercase letters, digits and hyphens; reserved words are refused (app/lib/slugs.ts).
  slug            String            @unique
  name            String
  kind            WorkspaceKind
  // PERSONAL only: the user it belongs to. Deleted with them.
  personalOwnerId String?           @unique
  personalOwner   User?             @relation("PersonalWorkspace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  // Set by the instance administrator (/admin/workspaces): nobody can open its boards
  // until it is lifted. The reason is shown to the workspace's members.
  suspendedAt     DateTime?
  suspendedReason String?
  // Security policy of an organization (/<slug>/settings/security, docs/workspaces.md):
  // nobody without two-step verification opens its boards, and new employee accounts and
  // board invitations are limited to these email domains (empty = any).
  requireTwoFactor    Boolean       @default(false)
  allowedEmailDomains String[]      @default([])
  // Brand (/<slug>/settings/general): a colour of BOARD_COLORS, a logo on disk (random name
  // in ORGTABLE_UPLOAD_DIR, PNG/JPEG/WebP only, served by /api/workspaces/<slug>/logo) and the
  // organization's time zone (IANA), used to schedule its backups.
  brandColor      String?
  logoStoredName  String?
  logoMimeType    String?
  timezone        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  members         WorkspaceMember[]
  boards          Board[]
  // Accounts this organization created for its employees (User.managedById).
  managedUsers    User[]            @relation("ManagedUsers")
  customRoles     WorkspaceCustomRole[]
  teams           Team[]
  webhooks        Webhook[]
  incomingHooks   IncomingHook[]
  apiKeys         WorkspaceApiKey[]
  backupConfig    BackupConfig?
  backups         Backup[]
}

model WorkspaceMember {
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         WorkspaceRole        @default(MEMBER)
  // A custom role of THIS organization (only with role MEMBER): the member holds exactly its
  // permissions. The foreign key includes workspaceId, so the database itself refuses a role
  // of another organization. Deleting a role first clears it from its members (services).
  customRoleId String?
  customRole   WorkspaceCustomRole? @relation(fields: [workspaceId, customRoleId], references: [workspaceId, id], onDelete: NoAction)
  addedAt      DateTime             @default(now())
  teams        TeamMember[]

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([customRoleId])
}

// A role an organization defines on top of the three base ones: a name, a colour and a set
// of permissions (app/lib/permissions.ts). See docs/roles.md.
model WorkspaceCustomRole {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // A key of BOARD_COLORS (app/lib/colors.ts).
  color       String
  description String?
  // Permission names. Validated on write and sanitized again on read (permissionsOf).
  permissions String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
}

// A group of people of an organization that gets access to some of its boards together
// (docs/teams.md). Both join tables carry workspaceId inside their foreign keys: a team can
// only hold members of its own organization and boards of its own organization, and leaving
// the organization removes the person from its teams (cascade).
model Team {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // A key of BOARD_COLORS (app/lib/colors.ts).
  color       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  boards      TeamBoard[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
}

model TeamMember {
  teamId      String
  workspaceId String
  userId      String
  team        Team            @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Cascade)
  member      WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  addedAt     DateTime        @default(now())

  @@id([teamId, userId])
  @@index([workspaceId, userId])
}

// The role a team's members get on a board (VIEWER, EDITOR or OWNER), on top of whatever
// else gives them access: the effective role is the highest (app/lib/access.ts).
model TeamBoard {
  teamId      String
  workspaceId String
  boardId     String
  role        BoardRole @default(EDITOR)
  team        Team      @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Cascade)
  board       Board     @relation(fields: [workspaceId, boardId], references: [workspaceId, id], onDelete: Cascade)
  addedAt     DateTime  @default(now())

  @@id([teamId, boardId])
  @@index([boardId])
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  passwordHash         String
  name                 String
  role                 Role              @default(MEMBER)
  // When the person accepted the privacy policy and terms on sign-up (/register).
  // Null for accounts created by the admin or by the setup wizard.
  termsAcceptedAt      DateTime?
  // Interface language chosen by the person ("en", "es"…; see locales/index.ts). Null
  // until they pick one: then the browser decides. Notifications for them are written in
  // this language.
  locale               String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  boards               Board[]
  memberships          BoardMember[]
  sessions             Session[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  apiTokens            ApiToken[]
  assignedCards        CardAssignee[]
  comments             Comment[]
  personalWorkspace    Workspace?        @relation("PersonalWorkspace")
  workspaceMemberships WorkspaceMember[]
  // Set when an organization created this account for an employee: its owners and admins
  // can reset the password or delete it. Null for people who signed up themselves.
  managedById          String?
  managedBy            Workspace?        @relation("ManagedUsers", fields: [managedById], references: [id], onDelete: SetNull)
  accountTokens        AccountToken[]
  // Two-step verification (TOTP, docs/authentication.md). The secret is encrypted with
  // ORGTABLE_SECRET_KEY (app/lib/crypto/secrets.ts, context "totp:<userId>"); while it is
  // being set up it waits in totpPendingEnc until the first code confirms it.
  // totpLastStep refuses a code that was already used. Recovery codes: SHA-256 of each
  // unused code, removed as they are used.
  totpSecretEnc        String?
  totpPendingEnc       String?
  totpEnabledAt        DateTime?
  totpLastStep         Int?
  recoveryCodeHashes   String[]          @default([])
  workspaceApiKeys     WorkspaceApiKey[]
}

// What a single-use link sent by email lets its holder do with an account.
enum AccountTokenPurpose {
  // "Forgot your password": choose a new one. Valid for an hour.
  PASSWORD_RESET
  // An organization created the account: its owner chooses their password. Valid a week.
  INVITE
}

// Single-use links sent by email. Only the SHA-256 of the token is stored (like API
// tokens): someone who reads the database cannot use them. Consuming one sets the
// password, revokes every session and API token of the account and deletes the account's
// other links. See app/lib/services/account-tokens.ts and docs/email.md.
model AccountToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  createdAt DateTime            @default(now())

  @@index([userId])
}

// Server-side session. The cookie is still a signed JWT, but it carries the id of THIS
// row (sid). The DAL validates the JWT and also checks that the session exists, is not
// revoked and has not expired: this makes revocation IMMEDIATE (sign out, password reset
// by the admin, "sign out on all devices"). See docs/authentication.md and
// docs/decisions/0008-session-store.md.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Board {
  id          String          @id @default(cuid())
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Second URL segment (/<workspace>/<slug>), from the title, unique in its workspace.
  // The board id works in its place too and redirects here.
  slug        String
  visibility  BoardVisibility @default(WORKSPACE)
  title       String
  description String?
  background  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lists       List[]
  labels      Label[]
  members     BoardMember[]
  teams       TeamBoard[]
  webhooks    Webhook[]
  incoming    IncomingHook[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, id])
  @@index([ownerId])
}

model List {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  // Fractional indexing sort key (lexicographic string).
  // Moving a list updates ONLY its own row. See docs/drag-and-drop.md.
  // In the DB the column is TEXT COLLATE "C" (byte order), like
  // Card/Checklist/ChecklistItem.position: with the default (glibc) collation 'Zz' would
  // sort after 'a0'. Prisma does not model collations; the
  // 20260924000000_position_collate_c migration sets it. See ADR 0002.
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
  incoming  IncomingHook[]

  @@index([boardId])
}

model Card {
  id          String         @id @default(cuid())
  listId      String
  list        List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Fractional indexing sort key (see List.position).
  position    String
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  labels      CardLabel[]
  checklists  Checklist[]
  attachments Attachment[]
  assignees   CardAssignee[]
  comments    Comment[]

  @@index([listId, position])
}

// Card attachments. The binary is stored on disk (configurable volume, see
// app/lib/storage.ts); only the metadata lives here. `storedName` is the random file
// name on disk; `filename` is the original name the user sees. See docs/attachments.md.
model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([cardId])
}

model Label {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String
  cards   CardLabel[]

  @@index([boardId])
}

// Many-to-many join table between Card and Label.
model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

// Checklists inside a card. A card can have several checklists, each with several
// checkable items.
model Checklist {
  id        String          @id @default(cuid())
  cardId    String
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  position  String
  createdAt DateTime        @default(now())
  items     ChecklistItem[]

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  position    String
  createdAt   DateTime  @default(now())

  @@index([checklistId])
}

// Audit log. One row per relevant security or operations event (login, user created or
// removed, role changes, board deletion...). The user is optional, with
// onDelete: SetNull, so the history is kept even if the account is deleted. See
// app/lib/audit.ts and docs/operations.md.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  detail      String?
  ip          String?
  // The workspace the event belongs to, for its own activity log (/<slug>/settings/audit). A
  // SOFT reference (no FK), like Notification.boardId: "organization deleted" must outlive
  // the organization in the instance's log. Set by recordAudit (app/lib/audit.ts).
  workspaceId String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([workspaceId, createdAt])
}

// A user's membership in a board. It already existed in the single-user MVP so that
// every Server Action's authorization went through it from the start, with no
// re-migration needed when multi-user support arrived.
model BoardMember {
  boardId String
  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    BoardRole @default(EDITOR)
  addedAt DateTime  @default(now())

  @@id([boardId, userId])
  @@index([userId])
}

// Per-user in-app notifications. The text is rendered when the notification is created,
// in the recipient's language (User.locale), instead of storing a structured payload,
// which keeps rendering trivial. `boardId` is a SOFT reference (string, no FK): if the
// board is deleted, the notification survives and the link simply does not resolve.
// Live delivery goes through the pub/sub bus (per-user channel). See
// app/lib/notifications.ts, docs/notifications.md and
// docs/decisions/0012-notifications.md.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  boardId   String?
  // Soft reference to the card (no FK): enables the `?card=` deep link and deduplicating
  // due-date reminders.
  cardId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

// Personal access token for the public API. The token is NEVER stored in plain text:
// only its SHA-256 hash (`tokenHash`, unique) and a visible `prefix` so the user can
// recognise it in the list. The full token is shown ONLY ONCE, when it is created.
// Requests to /api/v1/* send it as `Authorization: Bearer <token>` and it is looked up
// by hash. See app/lib/api/tokens.ts, docs/api/public-api.md and
// docs/decisions/0013-api-tokens.md.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  // Token scope: "full" (read+write) or "read" (read-only).
  scope      String    @default("full")
  // Optional expiry: if set and already past, the token stops working.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Assignment of a card to a board member. Join table: a person can have several cards
// and a card several assignees. Authorization (the assignee must be a board member) is
// enforced by the Server Action. See docs/card-collaboration.md.
model CardAssignee {
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// Comment on a card. Flat thread, no nesting. Deleted in cascade with the card or the
// author. See docs/card-collaboration.md.
model Comment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
}

// --- Webhooks (docs/webhooks.md) ------------------------------------------------------------

// What a webhook sends: orgtable's own JSON, or a message already formatted for a chat.
enum WebhookFormat {
  JSON
  SLACK
  DISCORD
  TEAMS
}

// An outgoing webhook of an organization: every board of it (boardId null) or one board. The
// board's foreign key includes workspaceId, so a webhook never points at another
// organization's board. The signing secret is encrypted (app/lib/crypto/secrets.ts); after a
// rotation the previous one keeps signing too until previousSecretUntil.
model Webhook {
  id                  String            @id @default(cuid())
  workspaceId         String
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boardId             String?
  board               Board?            @relation(fields: [workspaceId, boardId], references: [workspaceId, id], onDelete: Cascade)
  name                String
  url                 String
  format              WebhookFormat     @default(JSON)
  // Event names (app/lib/webhooks/events.ts).
  events              String[]
  secretEnc           String
  previousSecretEnc   String?
  previousSecretUntil DateTime?
  active              Boolean           @default(true)
  // Final failures in a row. At the limit the webhook is switched off (disabledAt) and the
  // settings page says why.
  consecutiveFailures Int               @default(0)
  disabledAt          DateTime?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveries          WebhookDelivery[]

  @@unique([workspaceId, id])
  @@index([workspaceId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// One event sent (or to be sent) to one webhook, with every attempt's outcome. Retried with
// growing waits; kept for 30 days (POST /api/cron/maintenance).
model WebhookDelivery {
  id             String                @id @default(cuid())
  webhookId      String
  webhook        Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  // The exact body sent (already in the webhook's format), so a retry or a redelivery sends
  // the same bytes and the log shows what went out.
  body           String
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  // Who is sending it now (a claim with a deadline, so a crashed sender does not hold it).
  lockedUntil    DateTime?
  responseStatus Int?
  responseBody   String?
  error          String?
  durationMs     Int?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

// An incoming webhook: a secret URL that creates cards in one list of one board
// (POST /api/hooks/in/<token>). Only the SHA-256 of the token is kept, like API tokens.
model IncomingHook {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boardId     String
  board       Board     @relation(fields: [workspaceId, boardId], references: [workspaceId, id], onDelete: Cascade)
  listId      String
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  // The first characters of the token, to recognise it in the list.
  prefix      String
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  useCount    Int       @default(0)

  @@index([workspaceId])
}

// An API key of an organization (docs/api/public-api.md, "Organization keys"): it only reaches
// that organization's boards, never more than editing (no deleting boards or managing
// people), and acts on behalf of whoever created it, who must still be a member. Only its
// SHA-256 is stored; it is shown once. Leaving the organization deletes one's keys.
model WorkspaceApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  prefix      String
  // "read" or "full" (read and write), like personal tokens.
  scope       String    @default("read")
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// --- Backups (docs/backups.md) --------------------------------------------------------------

enum BackupFrequency {
  OFF
  DAILY
  WEEKLY
  MONTHLY
}

enum BackupDestination {
  LOCAL
  S3
}

// How and where an organization (workspaceId) or the whole instance (workspaceId null, id
// "instance") is backed up. The S3 credentials are encrypted (app/lib/crypto/secrets.ts).
model BackupConfig {
  id                 String            @id
  workspaceId        String?           @unique
  workspace          Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  frequency          BackupFrequency   @default(OFF)
  // Hour of the day (0–23) in the organization's time zone (Workspace.timezone, else the
  // instance's).
  hour               Int               @default(3)
  // Scheduled backups kept; older ones are deleted. Manual ones are never deleted on their own.
  retention          Int               @default(14)
  includeAttachments Boolean           @default(true)
  destination        BackupDestination @default(LOCAL)
  s3Endpoint         String?
  s3Region           String?
  s3Bucket           String?
  s3Prefix           String?
  s3AccessKeyEnc     String?
  s3SecretKeyEnc     String?
  // Encrypt the file before it leaves this server (AES-256-GCM with ORGTABLE_SECRET_KEY).
  encrypt            Boolean           @default(true)
  lastScheduledAt    DateTime?
  updatedAt          DateTime          @updatedAt
}

enum BackupKind {
  MANUAL
  SCHEDULED
  BEFORE_IMPORT
  BEFORE_RESTORE
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

// One backup file of an organization (workspaceId) or of the instance (null). The file is a
// .zip (docs/backups.md, "Format"), maybe encrypted, on this server or in S3.
model Backup {
  id                  String            @id @default(cuid())
  workspaceId         String?
  workspace           Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind                BackupKind
  status              BackupStatus      @default(RUNNING)
  destination         BackupDestination
  // Path under the backups directory, or the object key in S3.
  location            String?
  size                Int?
  encrypted           Boolean           @default(false)
  includesAttachments Boolean           @default(true)
  error               String?
  createdById         String?
  createdAt           DateTime          @default(now())
  finishedAt          DateTime?

  @@index([workspaceId, createdAt])
}
