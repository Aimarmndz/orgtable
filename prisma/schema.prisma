// orgtable — esquema de base de datos (Prisma + PostgreSQL)
// Documentado en docs/database.md. Decisiones: docs/decisions/0001-prisma.md,
// 0002-fractional-indexing.md.

generator client {
  provider = "prisma-client-js"
}

// En Prisma 7 la `url` ya NO va aquí: se define en prisma.config.ts (para el CLI de
// Migrate) y en runtime el PrismaClient se conecta mediante el driver adapter
// @prisma/adapter-pg (ver app/lib/prisma.ts). El query engine es WASM, no binario,
// por lo que no hace falta `binaryTargets` ni copiar engines a la imagen Docker.
datasource db {
  provider = "postgresql"
}

// Configuración global de la instancia. Es una fila única (id fijo "singleton").
// `setupCompletedAt` no-nulo es la fuente de verdad de "la instancia ya está
// configurada"; mientras sea null, el setup wizard (/setup) está activo.
model InstanceConfig {
  id               String    @id @default("singleton")
  instanceName     String
  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
}

enum Role {
  ADMIN
  MEMBER
}

enum BoardRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(MEMBER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  boards        Board[]
  memberships   BoardMember[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
  apiTokens     ApiToken[]
  assignedCards CardAssignee[]
  comments      Comment[]
}

// Sesión de servidor (Hito 4). La cookie sigue siendo un JWT firmado, pero ahora
// lleva el id de ESTA fila (sid). El DAL valida el JWT y además comprueba que la
// sesión existe, no está revocada y no ha expirado: así la revocación es INMEDIATA
// (cerrar sesión, restablecer contraseña por el admin, "cerrar en todos los
// dispositivos"). Ver docs/authentication.md y docs/decisions/0008-session-store.md.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Board {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  background  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lists       List[]
  labels      Label[]
  members     BoardMember[]

  @@index([ownerId])
}

model List {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  // Clave de ordenación por fractional indexing (string lexicográfico).
  // Mover una lista actualiza SOLO su propia fila. Ver docs/drag-and-drop.md.
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]

  @@index([boardId])
}

model Card {
  id          String      @id @default(cuid())
  listId      String
  list        List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Clave de ordenación por fractional indexing (ver List.position).
  position    String
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  labels      CardLabel[]
  checklists  Checklist[]
  attachments Attachment[]
  assignees   CardAssignee[]
  comments    Comment[]

  @@index([listId, position])
}

// Adjuntos de una tarjeta (Hito 5). El binario se guarda en disco (volumen
// configurable, ver app/lib/storage.ts); aquí solo viven los metadatos. `storedName`
// es el nombre aleatorio del fichero en disco; `filename` es el nombre original que ve
// el usuario. Ver docs/attachments.md.
model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([cardId])
}

model Label {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String
  cards   CardLabel[]

  @@index([boardId])
}

// Tabla de unión muchos-a-muchos entre Card y Label.
model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

// Listas de comprobación dentro de una tarjeta (Hito 2). Una tarjeta puede tener
// varias checklists; cada una con varios ítems marcables.
model Checklist {
  id        String          @id @default(cuid())
  cardId    String
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  position  String
  createdAt DateTime        @default(now())
  items     ChecklistItem[]

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  position    String
  createdAt   DateTime  @default(now())

  @@index([checklistId])
}

// Membresía de un usuario en un tablero. Se crea ya en el MVP (single-user) para
// que la autorización de cada Server Action pase por aquí desde el principio y no
// haya que re-migrar al llegar el hito multiusuario.
// Registro de auditoría (Hito 5). Una fila por evento relevante de seguridad u
// operación (login, alta/baja de usuario, cambios de rol, borrado de tablero...). El
// usuario es opcional y con onDelete: SetNull para conservar el historial aunque la
// cuenta se borre. Ver app/lib/audit.ts y docs/operations.md.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model BoardMember {
  boardId String
  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    BoardRole @default(EDITOR)
  addedAt DateTime  @default(now())

  @@id([boardId, userId])
  @@index([userId])
}

// Notificaciones in-app por usuario (Hito 8). El texto se precalcula en español al
// crearlas (no se guarda un payload estructurado: la app es monolingüe y así el render
// es trivial). `boardId` es una referencia SUAVE (string, sin FK): si el tablero se
// borra, la notificación sobrevive y el enlace simplemente no resuelve. La entrega en
// vivo va por el bus pub/sub (canal por usuario). Ver app/lib/notifications.ts,
// docs/notifications.md y docs/decisions/0012-notifications.md.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  boardId   String?
  // Referencia suave a la tarjeta (sin FK): permite el deep-link `?card=` y deduplicar
  // los recordatorios de vencimiento (Hito 11).
  cardId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

// Token de acceso personal para la API pública (Hito 9). NUNCA se guarda el token en
// claro: solo su hash SHA-256 (`tokenHash`, único) y un `prefix` visible para que el
// usuario lo reconozca en la lista. El token completo se muestra UNA sola vez al
// crearlo. La petición a /api/v1/* lo manda en `Authorization: Bearer <token>` y se
// resuelve por hash. Ver app/lib/api/tokens.ts, docs/api/public-api.md y
// docs/decisions/0013-api-tokens.md.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  // Alcance del token (Hito 13): "full" (lectura+escritura) o "read" (solo lectura).
  scope      String    @default("full")
  // Caducidad opcional (Hito 13): si está y ya pasó, el token deja de valer.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Asignación de una tarjeta a un miembro del tablero (Hito 10). Tabla de unión: una
// persona puede tener varias tarjetas y una tarjeta varios asignados. La autorización
// (que el asignado sea miembro del tablero) la garantiza la Server Action. Ver
// docs/card-collaboration.md.
model CardAssignee {
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// Comentario en una tarjeta (Hito 10). Hilo simple, sin anidación. Se borra en cascada
// con la tarjeta o con el autor. Ver docs/card-collaboration.md.
model Comment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
}
