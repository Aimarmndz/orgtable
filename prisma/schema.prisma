// orgtable — database schema (Prisma + PostgreSQL)
// Documented in docs/database.md. Decisions: docs/decisions/0001-prisma.md,
// 0002-fractional-indexing.md.

generator client {
  provider = "prisma-client-js"
}

// In Prisma 7 the `url` NO longer goes here: it is defined in prisma.config.ts (for the
// Migrate CLI) and at runtime PrismaClient connects through the @prisma/adapter-pg
// driver adapter (see app/lib/prisma.ts). The query engine is WASM, not a binary, so
// there is no need for `binaryTargets` or copying engines into the Docker image.
datasource db {
  provider = "postgresql"
}

// Instance-wide settings. A single row (fixed id "singleton").
// A non-null `setupCompletedAt` is the source of truth for "the instance is already
// set up"; while it is null, the setup wizard (/setup) is active.
model InstanceConfig {
  id               String    @id @default("singleton")
  instanceName     String
  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  // Open sign-up: anyone can create an account at /register. Closed by default (private
  // instance, the admin creates accounts). It can only be opened once the controller and
  // the privacy contact are set, because the privacy policy needs them.
  registrationOpen Boolean   @default(false)
  // Legal details of WHOEVER OPERATES this instance (not the software's author). Shown
  // on /legal/*. All optional: without them the legal pages say so instead of making
  // anything up. See docs/privacy.md.
  operatorName        String?
  operatorEmail       String?
  operatorLegalId     String?
  operatorAddress     String?
  hostingDescription  String?
  backupRetentionDays Int?
  // Date the legal details were last edited: it is the "last updated" date shown on the
  // legal pages.
  legalUpdatedAt      DateTime?
}

enum Role {
  ADMIN
  MEMBER
}

enum BoardRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(MEMBER)
  // When the person accepted the privacy policy and terms on sign-up (/register).
  // Null for accounts created by the admin or by the setup wizard.
  termsAcceptedAt DateTime?
  // Interface language chosen by the person ("en", "es"…; see locales/index.ts). Null
  // until they pick one: then the browser decides. Notifications for them are written in
  // this language.
  locale       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  boards        Board[]
  memberships   BoardMember[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
  apiTokens     ApiToken[]
  assignedCards CardAssignee[]
  comments      Comment[]
}

// Server-side session. The cookie is still a signed JWT, but it carries the id of THIS
// row (sid). The DAL validates the JWT and also checks that the session exists, is not
// revoked and has not expired: this makes revocation IMMEDIATE (sign out, password reset
// by the admin, "sign out on all devices"). See docs/authentication.md and
// docs/decisions/0008-session-store.md.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Board {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  background  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lists       List[]
  labels      Label[]
  members     BoardMember[]

  @@index([ownerId])
}

model List {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  // Fractional indexing sort key (lexicographic string).
  // Moving a list updates ONLY its own row. See docs/drag-and-drop.md.
  // In the DB the column is TEXT COLLATE "C" (byte order), like
  // Card/Checklist/ChecklistItem.position: with the default (glibc) collation 'Zz' would
  // sort after 'a0'. Prisma does not model collations; the
  // 20260924000000_position_collate_c migration sets it. See ADR 0002.
  position  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]

  @@index([boardId])
}

model Card {
  id          String      @id @default(cuid())
  listId      String
  list        List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // Fractional indexing sort key (see List.position).
  position    String
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  labels      CardLabel[]
  checklists  Checklist[]
  attachments Attachment[]
  assignees   CardAssignee[]
  comments    Comment[]

  @@index([listId, position])
}

// Card attachments. The binary is stored on disk (configurable volume, see
// app/lib/storage.ts); only the metadata lives here. `storedName` is the random file
// name on disk; `filename` is the original name the user sees. See docs/attachments.md.
model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([cardId])
}

model Label {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String
  cards   CardLabel[]

  @@index([boardId])
}

// Many-to-many join table between Card and Label.
model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

// Checklists inside a card. A card can have several checklists, each with several
// checkable items.
model Checklist {
  id        String          @id @default(cuid())
  cardId    String
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  position  String
  createdAt DateTime        @default(now())
  items     ChecklistItem[]

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  position    String
  createdAt   DateTime  @default(now())

  @@index([checklistId])
}

// Audit log. One row per relevant security or operations event (login, user created or
// removed, role changes, board deletion...). The user is optional, with
// onDelete: SetNull, so the history is kept even if the account is deleted. See
// app/lib/audit.ts and docs/operations.md.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// A user's membership in a board. It already existed in the single-user MVP so that
// every Server Action's authorization went through it from the start, with no
// re-migration needed when multi-user support arrived.
model BoardMember {
  boardId String
  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    BoardRole @default(EDITOR)
  addedAt DateTime  @default(now())

  @@id([boardId, userId])
  @@index([userId])
}

// Per-user in-app notifications. The text is rendered when the notification is created,
// in the recipient's language (User.locale), instead of storing a structured payload,
// which keeps rendering trivial. `boardId` is a SOFT reference (string, no FK): if the
// board is deleted, the notification survives and the link simply does not resolve.
// Live delivery goes through the pub/sub bus (per-user channel). See
// app/lib/notifications.ts, docs/notifications.md and
// docs/decisions/0012-notifications.md.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  boardId   String?
  // Soft reference to the card (no FK): enables the `?card=` deep link and deduplicating
  // due-date reminders.
  cardId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

// Personal access token for the public API. The token is NEVER stored in plain text:
// only its SHA-256 hash (`tokenHash`, unique) and a visible `prefix` so the user can
// recognise it in the list. The full token is shown ONLY ONCE, when it is created.
// Requests to /api/v1/* send it as `Authorization: Bearer <token>` and it is looked up
// by hash. See app/lib/api/tokens.ts, docs/api/public-api.md and
// docs/decisions/0013-api-tokens.md.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  // Token scope: "full" (read+write) or "read" (read-only).
  scope      String    @default("full")
  // Optional expiry: if set and already past, the token stops working.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Assignment of a card to a board member. Join table: a person can have several cards
// and a card several assignees. Authorization (the assignee must be a board member) is
// enforced by the Server Action. See docs/card-collaboration.md.
model CardAssignee {
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// Comment on a card. Flat thread, no nesting. Deleted in cascade with the card or the
// author. See docs/card-collaboration.md.
model Comment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
}
